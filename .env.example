# .env.example - contains no real credentials.
# Copy this file to .env and fill in your own values. .env is ignored by git.

# LLM: "openai" for any OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, Ollama), or "mock" to run offline.
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=YOUR_LOCAL_API_KEY_HERE
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_STEPS=6

# Threat intelligence (optional: a provider without a key is skipped)
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# Where imported events and cases are stored
TRIAGEDESK_DATA_DIR=./data

# Time zone of auth.log lines, which carry no zone (for example UTC or America/Toronto)
LOG_TIMEZONE=UTC

# Detection thresholds (optional; these are the defaults)
DETECT_WAZUH_MIN_LEVEL=7
DETECT_BRUTE_FORCE_THRESHOLD=10
DETECT_BRUTE_FORCE_WINDOW_MINUTES=5
DETECT_SUCCESS_AFTER_FAILURE_MIN_FAILURES=5
DETECT_SUCCESS_AFTER_FAILURE_WINDOW_MINUTES=10
DETECT_WEB_SCAN_THRESHOLD=30
DETECT_WEB_SCAN_WINDOW_MINUTES=2

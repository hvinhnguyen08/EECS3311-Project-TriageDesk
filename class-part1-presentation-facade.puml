@startuml
skinparam dpi 150
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam classFontStyle bold
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 50
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #333333
  ArrowColor #333333
}
skinparam package {
  BackgroundColor #F7F7F7
  BorderColor #999999
}
hide circle
hide empty members

title Class Diagram Part 1: Presentation (MVC GUI and CLI) and Facade
top to bottom direction
package "GUI (JavaFX): views and controllers" {
class MainView <<view>> {
  + showImportDialog() : Path
  + showCases(cases : List<Case>) : void
  + addImportedFile(batchId : String) : void
  + showSummary(r : AgentResult) : void
  + showMessage(msg : String) : void
  + showError(msg : String) : void
}
class CaseView <<view>> {
  + render(c : Case) : void
  + showVerdict(v : TriageVerdict) : void
  + showPlan(p : ResponsePlan) : void
  + showReportPath(p : Path) : void
  + showError(msg : String) : void
}
class DashboardView <<view>> {
  + render(s : DashboardStats) : void
}
class ChatView <<view>> {
  + showAnswer(r : AgentResult) : void
  + showError(msg : String) : void
}
class MainController <<controller>> {
  - assistant : SocAssistant
  - view : MainView
  --
  + onImport() : void
  + onRunDetections() : void
  + onSummarize(batchId : String) : void
  + onOpenCase(caseId : String) : void
}
class CaseController <<controller>> {
  - assistant : SocAssistant
  - view : CaseView
  - caseId : String
  --
  + onEnrich() : void
  + onMapAttack() : void
  + onTriage() : void
  + onChangeStatus(action : String, comment : String) : void
  + onAddNote(text : String) : void
  + onRecommendResponse() : void
  + onGenerateReport() : void
}
class DashboardController <<controller>> {
  - assistant : SocAssistant
  - view : DashboardView
  --
  + refresh() : void
}
class ChatController <<controller>> {
  - assistant : SocAssistant
  - view : ChatView
  --
  + onAsk(question : String) : void
}
}
package "CLI" {
class TriageDeskCli <<CLI (picocli)>> {
  - assistant : SocAssistant
  --
  + main(args : String[]) : void
  + importFile(path : Path) : int
  + detect() : int
  + summarize(batchId : String) : int
  + enrich(caseId : String) : int
  + map(caseId : String) : int
  + triage(caseId : String) : int
  + status(caseId : String, action : String, comment : String) : int
  + note(caseId : String, text : String) : int
  + respond(caseId : String) : int
  + report(caseId : String, out : Path) : int
  + ask(question : String) : int
  + stats() : int
}
}
package "Facade" {
class SocAssistant <<Facade>> {
  - eventStore : EventStore
  - parserFactory : LogParserFactory
  - detectionEngine : DetectionEngine
  - caseManager : CaseManager
  - enrichment : EnrichmentService
  - attackMapper : AttackMapper
  - agent : SocAgent
  - reportGenerator : ReportGenerator
  --
  + importFile(path : Path) : int
  + runDetections() : List<Case>
  + summarizeLog(batchId : String) : AgentResult
  + listCases() : List<Case>
  + getCase(caseId : String) : Case
  + enrichIocs(caseId : String) : List<Ioc>
  + mapAttack(caseId : String) : List<AttackTechnique>
  + triageCase(caseId : String) : TriageVerdict
  + changeStatus(caseId : String, action : String, comment : String) : Case
  + addNote(caseId : String, text : String) : Case
  + recommendResponse(caseId : String) : ResponsePlan
  + generateReport(caseId : String, out : Path) : Path
  + ask(question : String) : AgentResult
  + getDashboardStats() : DashboardStats
}
}
package "Defined in another part" {
class AttackMapper #EEEEEE
class CaseManager #EEEEEE
class DashboardStats #EEEEEE
class DetectionEngine #EEEEEE
class EnrichmentService #EEEEEE
class EventStore #EEEEEE
interface LogParser <<interface>> #EEEEEE
class LogParserFactory <<Factory>> #EEEEEE
class ReportGenerator #EEEEEE
class SocAgent <<AI agent>> #EEEEEE
class ToolRegistry #EEEEEE
}
MainController "1" -- "1" MainView : events / updates
MainController "*" --> "1" SocAssistant
CaseController "1" -- "1" CaseView : events / updates
CaseController "*" --> "1" SocAssistant
DashboardController "1" -- "1" DashboardView : events / updates
DashboardController "*" --> "1" SocAssistant
ChatController "1" -- "1" ChatView : events / updates
ChatController "*" --> "1" SocAssistant
TriageDeskCli "1" --> "1" SocAssistant
SocAssistant "1" --> "1" EventStore
SocAssistant "1" --> "1" LogParserFactory
SocAssistant "1" --> "1" DetectionEngine
SocAssistant "1" --> "1" CaseManager
SocAssistant "1" --> "1" EnrichmentService
SocAssistant "1" --> "1" AttackMapper
SocAssistant "1" --> "1" SocAgent
SocAssistant "1" --> "1" ReportGenerator
SocAssistant ..> LogParser : uses
SocAssistant ..> DashboardStats : creates
SocAssistant ..> ToolRegistry : creates tools, registers them
@enduml
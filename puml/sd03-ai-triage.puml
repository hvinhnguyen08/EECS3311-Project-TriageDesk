@startuml
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 220
skinparam ParticipantPadding 8
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #999999
  ParticipantBorderColor #333333
  ParticipantBackgroundColor #FFFFFF
  ActorBorderColor #333333
  ActorBackgroundColor #FFFFFF
  GroupBorderColor #999999
  GroupBackgroundColor #F7F7F7
}
hide footbox
autonumber
title SD03 - AI Case Triage with Tool Use (F06)
actor "SOC Analyst" as Analyst
boundary ":CaseView" as CaseView
control ":CaseController" as CaseController
participant ":SocAssistant" as SocAssistant
participant ":CaseManager" as CaseManager
participant ":SocAgent" as SocAgent
participant "llm:LlmClient" as LlmClient
participant "LLM Service\n(OpenAI / Ollama)" as LLMService <<external service>>
participant ":ToolRegistry" as ToolRegistry
participant "t:SearchEventsTool" as SearchEventsTool
participant ":EventStore" as EventStore

Analyst -> CaseView : click "AI Triage"
CaseView -> CaseController : onTriage()
CaseController -> SocAssistant : triageCase(caseId)
SocAssistant -> CaseManager : getCase(caseId)
CaseManager --> SocAssistant : c
SocAssistant -> SocAgent : triage(c)
SocAgent -> SocAgent : runLoop(system, prompt, toolNames)
SocAgent -> ToolRegistry : specs(toolNames)
ToolRegistry --> SocAgent : toolSpecs
note right of LlmClient : OpenAiClient at run time; MockLlmClient\nin tests (no call to the service)
loop until final answer or maxSteps (6)
  SocAgent -> LlmClient : chat(messages, toolSpecs)
  LlmClient -> LLMService : HTTPS POST /chat/completions
  LLMService --> LlmClient : JSON reply, or timeout / 401
  LlmClient --> SocAgent : reply, or LlmException
  break LlmException (timeout / invalid key)
    SocAgent --> SocAssistant : exception
    SocAssistant --> CaseController : exception (case unchanged)
    CaseController -> CaseView : showError("AI service unavailable")
  end
  alt reply.hasToolCall()
    SocAgent -> ToolRegistry : get(reply.toolName)
    ToolRegistry --> SocAgent : t
    note right of SearchEventsTool : example: the model\nasked for search_events
    SocAgent -> SearchEventsTool : execute(argsJson)
    SearchEventsTool -> EventStore : search(criteria)
    EventStore --> SearchEventsTool : events
    SearchEventsTool --> SocAgent : result (added to messages)
  else final answer
    note over SocAgent : leave the loop
  end
end
alt valid verdict JSON
  SocAgent --> SocAssistant : v (TriageVerdict)
else invalid JSON / maxSteps reached
  SocAgent --> SocAssistant : v (verdict NEEDS_REVIEW)
end
SocAssistant -> CaseManager : recordVerdict(caseId, v)
note right of CaseManager : setVerdict(v); a New case moves\nto Investigating; save(c)
CaseManager --> SocAssistant : c
SocAssistant --> CaseController : v
CaseController -> CaseView : showVerdict(v)
@enduml

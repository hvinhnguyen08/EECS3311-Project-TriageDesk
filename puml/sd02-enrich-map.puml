@startuml
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 220
skinparam ParticipantPadding 8
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #999999
  ParticipantBorderColor #333333
  ParticipantBackgroundColor #FFFFFF
  ActorBorderColor #333333
  ActorBackgroundColor #FFFFFF
  GroupBorderColor #999999
  GroupBackgroundColor #F7F7F7
}
hide footbox
autonumber
title SD02 - Enrich IOCs and Map to ATT&CK (F07, F08)
actor "SOC Analyst" as Analyst
boundary ":CaseView" as CaseView
control ":CaseController" as CaseController
participant ":SocAssistant" as SocAssistant
participant ":CaseManager" as CaseManager
participant "c:Case" as Case
participant ":EnrichmentService" as EnrichmentService
participant ":AbuseIpDbAdapter" as AbuseIpDbAdapter
participant ":AbuseIpDbApi" as AbuseIpDbApi <<external REST API>>
participant ":AttackMapper" as AttackMapper
participant ":SocAgent" as SocAgent

Analyst -> CaseView : click "Enrich IOCs"
CaseView -> CaseController : onEnrich()
CaseController -> SocAssistant : enrichIocs(caseId)
SocAssistant -> CaseManager : getCase(caseId)
CaseManager --> SocAssistant : c
SocAssistant -> EnrichmentService : enrich(c)
EnrichmentService -> EnrichmentService : extractIocs(c)
loop each public IOC not in the cache, for each provider
  EnrichmentService -> AbuseIpDbAdapter : supports(type)
  AbuseIpDbAdapter --> EnrichmentService : true
  EnrichmentService -> AbuseIpDbAdapter : lookup(value)
  AbuseIpDbAdapter -> AbuseIpDbApi : GET /api/v2/check?ipAddress=value
  alt API responds
    AbuseIpDbApi --> AbuseIpDbAdapter : json
    AbuseIpDbAdapter -> AbuseIpDbAdapter : parseScore(json)
    AbuseIpDbAdapter --> EnrichmentService : score (0 to 100)
  else timeout / rate limit (HTTP 429)
    AbuseIpDbAdapter --> EnrichmentService : -1 (unavailable)
  end
end
note right of AbuseIpDbAdapter : lookup() is called only when supports() is true.\nVirusTotalAdapter calls VirusTotalApi the same way.\nA provider without an API key is skipped.
EnrichmentService --> SocAssistant : iocs
SocAssistant -> Case : setIocs(iocs)
SocAssistant -> CaseManager : save(c)
SocAssistant --> CaseController : iocs
CaseController -> CaseView : render(c)

Analyst -> CaseView : click "Map to ATT&CK"
CaseView -> CaseController : onMapAttack()
CaseController -> SocAssistant : mapAttack(caseId)
SocAssistant -> CaseManager : getCase(caseId)
CaseManager --> SocAssistant : c
SocAssistant -> AttackMapper : map(c)
loop each technique id on the case's findings
  AttackMapper -> AttackMapper : find(id)
end
opt no technique ids on the case
  AttackMapper -> SocAgent : suggestTechniques(c)
  note right of SocAgent : runs the agent loop\nshown in SD03
  SocAgent --> AttackMapper : candidate ids
  AttackMapper -> AttackMapper : find(id), drop unknown ids
end
AttackMapper --> SocAssistant : techniques
SocAssistant -> Case : setTechniques(techniques)
SocAssistant -> CaseManager : save(c)
SocAssistant --> CaseController : techniques
CaseController -> CaseView : render(c)
@enduml

@startuml
!pragma layout smetana
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #333333
  ArrowColor #333333
}
skinparam rectangle {
  BackgroundColor #F7F7F7
  BorderColor #999999
}
left to right direction
title TriageDesk (Stage 2): use cases (GUI and CLI)
actor "SOC Analyst" as Analyst
actor "LLM Service\n(OpenAI-compatible: OpenAI, Groq,\nOpenRouter, Ollama)" as LLM
actor "Threat Intel Service\n(AbuseIPDB, VirusTotal)" as TI
rectangle "TriageDesk" {
  usecase "UC01 Import Log or Alert File" as UC01
  usecase "UC02 Run Detections and Create Cases" as UC02
  usecase "UC03 Summarize an Imported Log" as UC03
  usecase "UC04 Triage Case with AI" as UC04
  usecase "UC05 Enrich IOCs" as UC05
  usecase "UC06 Map Case to MITRE ATT&CK\n(detections, optional AI)" as UC06
  usecase "UC07 Manage Case Status and Notes" as UC07
  usecase "UC08 Get Response Recommendations\nand tick off steps" as UC08
  usecase "UC09 Generate Incident Report" as UC09
  usecase "UC10 Ask the Agent" as UC10
  usecase "UC11 View Dashboard" as UC11
  usecase "Look up IOC reputation\n(lookup_ioc tool)" as LOOKUP
}
Analyst -- UC01
Analyst -- UC02
Analyst -- UC03
Analyst -- UC04
Analyst -- UC05
Analyst -- UC06
Analyst -- UC07
Analyst -- UC08
Analyst -- UC09
Analyst -- UC10
Analyst -- UC11
UC04 ..> LOOKUP : <<include>>\n(when the agent decides)
UC10 ..> LOOKUP : <<include>>\n(when the agent decides)
UC03 -- LLM
UC04 -- LLM
UC06 -- LLM
UC08 -- LLM
UC09 -- LLM
UC10 -- LLM
UC05 -- TI
LOOKUP -- TI
@enduml

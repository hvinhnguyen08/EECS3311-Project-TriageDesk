@startuml
!pragma layout smetana
skinparam dpi 150
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam classFontStyle bold
skinparam packageStyle rectangle
skinparam nodesep 30
skinparam ranksep 40
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #333333
  ArrowColor #333333
}
skinparam package {
  BackgroundColor #F7F7F7
  BorderColor #999999
}
skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #999999
}
hide circle
hide empty members

title Class Diagram Part 3 (Stage 2): Log ingestion (Factory Method) and detection (Strategy)
left to right direction
package "Log ingestion (ingest)" {
  class LogParserFactory <<creator>> {
    - syslogZone : ZoneId
    --
    + detectFormat(path : Path) : String
    + detectFormat(lines : List<String>) : String
    + createParser(format : String) : LogParser
    + {static} readLines(path : Path) : List<String>
  }
  interface LogParser <<product>> {
    + parse(lines : List<String>, batchId : String) : List<SecurityEvent>
  }
  class WazuhAlertParser
  class AuthLogParser {
    - clock : Clock
    - zone : ZoneId
    --
    + {static} matchesLine(line : String) : boolean
  }
  class ApacheLogParser {
    + {static} matchesLine(line : String) : boolean
  }
  class UnsupportedFormatException
  class EventStore {
    - events : List<SecurityEvent>
    - dataDir : Path
    --
    + load() : void
    + addEvents(events : List<SecurityEvent>) : void
    + all() : List<SecurityEvent>
    + getBatch(batchId : String) : List<SecurityEvent>
    + batchIds() : List<String>
    + search(criteria : Map<String,String>) : List<SecurityEvent>
    + countBy(field : String, criteria : Map<String,String>) : Map<String,Integer>
    + size() : int
  }
}
package "Detection (detect)" {
  class DetectionEngine <<context>> {
    - detectors : List<Detector>
    - lastErrors : List<String>
    --
    + {static} withStandardDetectors(config : AppConfig) : DetectionEngine
    + register(d : Detector) : void
    + runAll(events : List<SecurityEvent>) : List<Finding>
    + getLastErrors() : List<String>
  }
  interface Detector <<strategy>> {
    + detect(events : List<SecurityEvent>) : List<Finding>
    + name() : String
  }
  class WazuhAlertDetector {
    - minLevel : int
  }
  class BruteForceDetector {
    - threshold : int
    - window : Duration
  }
  class SuccessAfterFailureDetector {
    - minFailures : int
    - window : Duration
  }
  class WebScanDetector {
    - notFoundThreshold : int
    - window : Duration
  }
}
package "config" {
  class AppConfig {
    + {static} load() : AppConfig
    + getDataDir() : Path
    + getLogTimeZone() : ZoneId
    + getLlmProvider() / getLlmModel() / ...
    + getBruteForceThreshold() / ... (DETECT_*)
  }
}
LogParser <|.. WazuhAlertParser
LogParser <|.. AuthLogParser
LogParser <|.. ApacheLogParser
LogParserFactory ..> LogParser : creates
LogParserFactory ..> UnsupportedFormatException : throws
LogParser ..> SecurityEvent : creates
EventStore "1" *-- "*" SecurityEvent
Detector <|.. WazuhAlertDetector
Detector <|.. BruteForceDetector
Detector <|.. SuccessAfterFailureDetector
Detector <|.. WebScanDetector
DetectionEngine "1" o-- "1..*" Detector
Detector ..> Finding : creates
DetectionEngine ..> AppConfig : thresholds
class SecurityEvent <<record>>
class Finding <<record>>
@enduml

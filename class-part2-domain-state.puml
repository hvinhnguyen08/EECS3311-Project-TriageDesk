@startuml
skinparam dpi 150
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam classFontStyle bold
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 50
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #333333
  ArrowColor #333333
}
skinparam package {
  BackgroundColor #F7F7F7
  BorderColor #999999
}
hide circle
hide empty members

title Class Diagram Part 2: Domain model and case lifecycle
top to bottom direction
package "Domain" {
class SecurityEvent {
  - id : String
  - batchId : String
  - timestamp : Instant
  - source : String
  - host : String
  - user : String
  - srcIp : String
  - message : String
  - ruleId : String
  - ruleLevel : int
  - mitreIds : List<String>
}
class Finding {
  - detector : String
  - title : String
  - severity : String
  - srcIp : String
  - host : String
  - user : String
  - techniqueIds : List<String>
  - firstSeen : Instant
  - lastSeen : Instant
  - events : List<SecurityEvent>
}
class Case {
  - id : String
  - title : String
  - severity : String
  - priority : int
  - state : CaseState
  - findings : List<Finding>
  - iocs : List<Ioc>
  - techniques : List<AttackTechnique>
  - verdict : TriageVerdict
  - responsePlan : ResponsePlan
  - notes : List<String>
  - history : List<String>
  --
  + startInvestigation() : void
  + escalate(reason : String) : void
  + close(verdict : String, comment : String) : void
  + reopen() : void
  + setState(s : CaseState) : void
  + addNote(text : String) : void
  + setIocs(iocs : List<Ioc>) : void
  + setTechniques(t : List<AttackTechnique>) : void
  + setVerdict(v : TriageVerdict) : void
  + setResponsePlan(p : ResponsePlan) : void
  + getEvents() : List<SecurityEvent>
}
class Ioc {
  - type : String
  - value : String
  - score : int
  - source : String
}
class TriageVerdict {
  - verdict : String
  - confidence : double
  - reasoning : String
  - toolTrace : List<String>
}
class AttackTechnique {
  - id : String
  - name : String
  - tactic : String
}
class ResponsePlan {
  - steps : List<String>
  - done : List<Boolean>
  --
  + markDone(index : int) : void
}
class DashboardStats {
  - totalEvents : int
  - topSourceIps : Map<String,Integer>
  - topUsers : Map<String,Integer>
  - casesByState : Map<String,Integer>
}
class AgentResult {
  - text : String
  - toolTrace : List<String>
  - stoppedEarly : boolean
}
}
package "Case lifecycle" {
abstract class CaseState <<abstract>> {
  + startInvestigation(c : Case) : void
  + escalate(c : Case, reason : String) : void
  + close(c : Case, verdict : String, comment : String) : void
  + reopen(c : Case) : void
  + name() : String
}
class NewState {
  + startInvestigation(c : Case) : void
  + close(c : Case, verdict : String, comment : String) : void
  + name() : String
}
class InvestigatingState {
  + escalate(c : Case, reason : String) : void
  + close(c : Case, verdict : String, comment : String) : void
  + name() : String
}
class EscalatedState {
  + close(c : Case, verdict : String, comment : String) : void
  + name() : String
}
class ClosedState {
  + reopen(c : Case) : void
  + name() : String
}
class CaseManager {
  - cases : Map<String,Case>
  - dataDir : Path
  --
  + createCases(findings : List<Finding>) : List<Case>
  + getCase(caseId : String) : Case
  + listCases() : List<Case>
  + applyAction(caseId : String, action : String, comment : String) : Case
  + addNote(caseId : String, text : String) : Case
  + save(c : Case) : void
  + recordVerdict(caseId : String, v : TriageVerdict) : Case
  + countByState() : Map<String,Integer>
  - groupFindings(f : List<Finding>) : List<List<Finding>>
  - computePriority(c : Case) : int
}
}
CaseState <|-- NewState
CaseState <|-- InvestigatingState
CaseState <|-- EscalatedState
CaseState <|-- ClosedState
Case "1" *-- "1..*" Finding
Finding "*" o-- "1..*" SecurityEvent : evidence
Case "1" *-- "*" Ioc
Case "*" o-- "*" AttackTechnique
Case "1" *-- "0..1" TriageVerdict
Case "1" *-- "0..1" ResponsePlan
Case "1" --> "1" CaseState : current state
CaseManager "1" *-- "*" Case
NewState -[hidden]down- EscalatedState
InvestigatingState -[hidden]down- ClosedState
@enduml